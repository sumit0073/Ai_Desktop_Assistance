{
  "name": "ai-desktop-app",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:bundle-secrets": "node scripts/check-bundle-secrets.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "ci:quality": "npm run lint && npm test && tsc -b && npm run build && npm run check:bundle-secrets",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:mac": "tauri build --bundles dmg",
    "tauri:build:win": "tauri build --bundles nsis,msi"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-http": "^2.8.2",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "libphonenumber-js": "^1.13.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-phone-number-input": "^3.4.18",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.4"
  }
}
