# Public anon key only — never put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where the SES "Reset password" button lands after Auth verify (must be allow-listed in
# Dashboard → Authentication → URL Configuration). Desktop can still use the email OTP code.
# VITE_AUTH_REDIRECT_URL=https://your-public-host.example/

# Optional — local Supabase only (`supabase start`). Hosted SMS uses Edge Function secrets + Auth Hook.
# See docs/auth-otp-setup.md
# SEND_SMS_HOOK_SECRETS=v1,whsec_...
# BLACKSMS_API_KEY=
# BLACKSMS_SENDER_ID=617
# BLACKSMS_ROUTE=1
# BLACKSMS_SMS_URL=https://blacksms.in/sms

# Amazon SES via Auth "Send Email" hook (Edge Function send-email). NOT Vite.
# Same SMTP_* keys as Mini Task Manager / OpsPick. Supabase built-in mail is NOT used.
# Hosted: supabase secrets set + deploy send-email + Dashboard → Hooks → Send Email
# See docs/auth-otp-setup.md
# AWS_SES_REGION=ap-south-1
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=2587
# (Edge Functions block 587; SES alternate STARTTLS port 2587 is required for send-email)
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="System Bunny <hello@opspick.com>"
# SEND_EMAIL_HOOK_SECRETS=v1,whsec_...
# Optional fallback redirect used by send-email when Auth omits redirect_to:
# AUTH_REDIRECT_URL=https://your-public-host.example/

# Model names only (no secrets) — must match chat-proxy allowlist
VITE_GROQ_MODEL=openai/gpt-oss-20b
VITE_GROQ_VISION_MODEL=qwen/qwen3.8-27b

# PRODUCTION: authenticated Supabase Edge Functions (required for release builds)
# https://<project-ref>.supabase.co/functions/v1/stt-proxy
VITE_STT_PROXY_URL=
# https://<project-ref>.supabase.co/functions/v1/chat-proxy
VITE_CHAT_PROXY_URL=

# Optional STT tuning (sent through the proxy; no secrets)
# VITE_GROQ_STT_MODEL=whisper-large-v3
# VITE_STT_LANGUAGE=en
# VITE_STT_VOCABULARY=Fibonacci sequence,binary search,dynamic programming

# LOCAL DEV ONLY — never set these for production CI / installers
# Requires BOTH the allow flag and the key; production builds ignore direct Groq.
# VITE_ALLOW_DIRECT_GROQ_STT=true
# VITE_ALLOW_DIRECT_GROQ_CHAT=true
# VITE_GROQ_API_KEY=your-groq-api-key

# OPT-IN live proxy tests (npm run test:live) — dedicated Auth user only.
# Never commit real passwords. See docs/proxy-deploy.md
# SEECOG_LIVE_PROXY_TESTS=1
# LIVE_TEST_EMAIL=
# LIVE_TEST_PASSWORD=
